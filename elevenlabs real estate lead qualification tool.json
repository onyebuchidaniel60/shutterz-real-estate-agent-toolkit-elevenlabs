    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\n// This Code node takes the agent's output, extracts the inner JSON array,\n// and merges all objects within that array into a single output item.\n\nconst input = $input.all();\n\nif (!input.length) {\n\treturn [];\n}\n\n// We'll accumulate output items here\nconst result = [];\n\nfor (const item of input) {\n\tconst raw = item.json.output;\n\n\tif (typeof raw !== 'string') {\n\t\t// skip non-string inputs\n\t\tcontinue;\n\t}\n\n\t// 1. Extract JSON within ```json ... ``` (or fallback to raw)\n\tlet jsonString = raw;\n\tconst fenced = raw.match(/```json\\s*([\\s\\S]*?)```/);\n\tif (fenced) {\n\t\tjsonString = fenced[1].trim(); // trim whitespace\n\t}\n\n\tlet arr;\n\ttry {\n\t\t// 2. Parse the extracted JSON string into an array of objects\n\t\tarr = JSON.parse(jsonString);\n\t} catch (e) {\n\t\tthrow new Error(`Could not parse JSON from agent output: ${e.message}`);\n\t}\n\n\tif (!Array.isArray(arr)) {\n\t\tthrow new Error('Parsed data is not an array');\n\t}\n\n\t// 3. MERGE all objects in the array 'arr' into a single object\n\t// This is the key change to eliminate 'undefined' cells.\n\tconst mergedData = arr.reduce((accumulator, currentObject) => {\n\t\t// Use the spread operator to combine the accumulator and the current object\n\t\treturn { ...accumulator, ...currentObject };\n\t}, {}); // Initialize the accumulator as an empty object\n\n\t// 4. Push the single merged object as ONE output item\n\t// This ensures that all data properties are present on the same item.\n\tif (Object.keys(mergedData).length > 0) {\n\t\tresult.push({ json: mergedData });\n\t}\n}\n\nreturn result;"
      },
